# npm install settings for the Cinetik build.
#
# Upstream shipped `install-strategy="nested"` (a bun-oriented setting) plus
# `node-linker=isolated` (a pnpm/bun key npm only warns about). With the nested
# strategy npm skips hoisting, which left `drizzle-orm` unreachable from
# better-auth's nested @better-auth/drizzle-adapter — `next build` then failed
# with "Module not found". Using npm's default (hoisted) layout fixes it.
#
# legacy-peer-deps stays on: the dependency tree has a peer conflict that npm
# otherwise refuses to resolve.
legacy-peer-deps=true
